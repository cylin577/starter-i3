# Keybind START

# Reload config (no restart)
bindsym $mod+Shift+c reload

# Restart i3 inplace
bindsym $mod+Shift+r restart

# Move windows
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+i move up
bindsym $mod+Shift+l move right

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show
# Promote scratchpad window to tiling on current workspace
bindsym $mod+Shift+p [title=".*"] scratchpad show, floating disable

# Close a window
bindsym $mod+Shift+q kill

# Move focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4

# Rofi
bindsym $mod+d exec rofi -show drun -theme Arc-Dark

# Launch terminal
bindsym $mod+Return exec alacritty

# Exit prompt
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+h resize shrink width 10 px
bindsym $mod+Ctrl+j resize grow height 10 px
bindsym $mod+Ctrl+k resize shrink height 10 px
bindsym $mod+Ctrl+l resize grow width 10 px

# System mode
set $mode_system System: (l)ock, lo(g)out, (r)eboot, (s)hutdown, (p)erformance
mode "$mode_system" {
    bindsym l exec i3lock -B 3 -k --inside-color=00000000 --ring-color 472a54 --keyhl-color=993dc4 -c 00000000, mode "default"
    bindsym e exec i3-msg exit, mode "default"
    bindsym s exec systemctl poweroff, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym p exec echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor, mode "default"
    
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Escape mode "$mode_system"
# Keybind END


